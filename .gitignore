# Godot 4 import cache and editor-local state.
.godot/
*.shader_cache
# Keep *.import and *.uid: they contain shared import settings and resource IDs.

# macOS metadata.
.DS_Store
._*

# Local exports and generated reports.
/build/
/builds/
/exports/
/test-results/
*.log

# Editor temporary files and Blender backup copies (keep original assets).
*.swp
*.swo
*~
*.tmp
*.blend1
*.blend2

# Local environment settings; sanitized examples may be committed.
.env
.env.*
!.env.example
!.env.sample

# --- Large binary assets not committed yet (kept out for repo size); ---
# --- add them back per-pattern, ideally via Git LFS, when needed.      ---
# NOTE: large assets already tracked by the shared repo are NOT listed here;
#       they stay in git even though they are big.
/学校.glb
/弹珠楼.glb
/_visual_check/ending_first_floor.avi
/神社.glb
/神社_神社_rm.png
/学校_学校_basecolor.jpg
/神社_神社_basecolor.jpg
/学校.glb.import
/弹珠楼.glb.import
/神社.glb.import

# Local LLM credentials and per-machine model configuration.
key.txt
llm_config.local.json
